    rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/quantitykind> .

#################################################################
# 4c. Local (FAIRmat) quantity kinds
# Kinds needed by the taxonomy that QUDT 3.5.2 does not define.
# Typed qudt:QuantityKind and described with QUDT's own properties:
# qudt:qkdvNumerator / qudt:qkdvDenominator for a ratio, and
# qudt:latexDefinition for the formula. OWL records but does not
# compute these relations.
#################################################################

fqk:CryoscopicConstant a owl:NamedIndividual, qudt:QuantityKind ;
    skos:prefLabel "CryoscopicConstant"@en ;
    rdfs:label "Cryoscopic Constant"@en ;
    skos:definition "Decrease in the freezing point per unit molality of solute: ThermodynamicTemperature / MolalityOfSolute (K·kg/mol)."@en ;
    qudt:qkdvNumerator qkdv:A0E0L0I0M0H1T0D0 ;
    qudt:qkdvDenominator qkdv:A1E0L0I0M-1H0T0D0 ;
    qudt:latexDefinition "$K_f = \\Delta T_f / b$" ;
    skos:related qk:ThermodynamicTemperature, qk:MolalityOfSolute ;
    skos:note "Local FAIRmat quantity kind (not in QUDT 3.5.2). Dimension A-1·M1·H1; QUDT 3.5.2 has no dimension-vector individual for it, so the ratio is given by numerator and denominator."@en ;
    rdfs:isDefinedBy <http://fairmat-nfdi.eu/taxonomy/representation> .

# QUDT dimension vectors referenced above (declared, not redefined).
qkdv:A0E0L-0dot5I0M1H0T-2D0 a owl:NamedIndividual, qudt:QuantityKindDimensionVector ;
    rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/dimensionvector> .
qkdv:A0E0L0I0M0H1T0D0 a owl:NamedIndividual, qudt:QuantityKindDimensionVector ;
    rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/dimensionvector> .
qkdv:A1E0L0I0M-1H0T0D0 a owl:NamedIndividual, qudt:QuantityKindDimensionVector ;
    rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/dimensionvector> .

# QUDT quantity kinds are distinct individuals. OWL makes no unique-name
# assumption, so without this the functional rep:HasComponentQuantityKind cannot
# detect two different kinds on one signal or axis (e.g. a TimeSeries
# axis with qk:Length would be read as qk:Length = qk:Time).
# Extend this list whenever a quantity kind is added.
[ a owl:AllDifferent ;
  owl:distinctMembers (
      qk:Time qk:Compressibility qk:Density qk:Dimensionless qk:DynamicViscosity
      qk:ElectricField qk:ElectricFieldStrength qk:ElectricPolarization
      qk:ElectromagneticPermeability qk:Energy qk:EnergyDensity
      qk:EnergyDensityOfStates qk:ForcePerArea qk:Frequency qk:Length
      qk:MagneticFieldStrength qk:Permittivity qk:Pressure qk:Stress
      qk:Temperature qk:Voltage qk:Wavenumber qk:StressIntensityFactor qk:Angle
      qk:Area qk:ChemicalPotential qk:ElectricCharge qk:ElectricCurrent
      qk:ElectricPotential qk:EnergyPerTemperature qk:InverseTemperature qk:Mass
      qk:MolarEnergy qk:NumberDensity qk:SpecificEnergy qk:SpecificHeatCapacity
      qk:ThermodynamicTemperature qk:Volume qk:LinearVelocity qk:InverseLength
      qk:MolalityOfSolute fqk:CryoscopicConstant ) ] .
