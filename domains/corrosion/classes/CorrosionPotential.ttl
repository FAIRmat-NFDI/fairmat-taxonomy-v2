@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:CorrosionPotential a owl:Class ;
    rdfs:comment "Electrode potential of a material in a corrosive environment."@en ;
    rdfs:subClassOf tax:CorrosionProperty ;
    skos:prefLabel "CorrosionPotential"@en .

