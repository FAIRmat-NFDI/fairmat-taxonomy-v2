@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:PassivationCurrent a owl:Class ;
    rdfs:comment "Flow of electrons during the formation of an oxide layer on the material surface."@en ;
    rdfs:subClassOf tax:CorrosionProperty ;
    skos:prefLabel "PassivationCurrent"@en .

