@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ThermalDiffusivity a owl:Class ;
    rdfs:comment "Measure of the rate of heat transfer inside a material."@en ;
    rdfs:subClassOf tax:ThermalTransportProperty ;
    skos:prefLabel "ThermalDiffusivity"@en .

