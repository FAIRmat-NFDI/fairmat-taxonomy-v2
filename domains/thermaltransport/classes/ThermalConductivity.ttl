@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ThermalConductivity a owl:Class ;
    rdfs:comment "Measure of the ability of the material to conduct heat in the presence of a temperature gradient."@en ;
    rdfs:subClassOf tax:ThermalTransportProperty ;
    skos:prefLabel "ThermalConductivity"@en .

