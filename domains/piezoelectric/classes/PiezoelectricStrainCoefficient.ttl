@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:PiezoelectricStrainCoefficient a owl:Class ;
    rdfs:comment "Amount of stress or deformation exhibited in response to an applied electric field."@en ;
    rdfs:subClassOf tax:PiezoelectricProperty ;
    skos:prefLabel "PiezoelectricStrainCoefficient"@en .

