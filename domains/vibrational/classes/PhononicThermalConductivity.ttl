@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/PhononicThermalConductivity> a owl:Class ;
    rdfs:comment "Contribution of the phononic degrees of freedom to the thermal conductivity."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/VibrationalProperty> ;
    skos:prefLabel "PhononicThermalConductivity"@en .

