@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:PhononicDensityOfStates a owl:Class ;
    rdfs:comment "Number of phonoic states accessible for the phonons per energy and per volume."@en ;
    rdfs:subClassOf tax:VibrationalProperty ;
    skos:altLabel "PhononicDOS"@en ;
    skos:prefLabel "PhononicDensityOfStates"@en .

