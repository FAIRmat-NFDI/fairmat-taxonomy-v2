@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/VibrationalProperty> a owl:Class ;
    rdfs:comment "Property that describes the behaviour of atom vibrations (phonons) in a given material."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/MaterialProperty> ;
    skos:altLabel "PhononicProperty"@en ;
    skos:prefLabel "VibrationalProperty"@en .

