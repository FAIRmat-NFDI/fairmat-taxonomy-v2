@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:PhononicBandStructure a owl:Class ;
    rdfs:comment "Accessible energies by the phonons in the reciprocal space."@en ;
    rdfs:subClassOf tax:VibrationalProperty ;
    skos:prefLabel "PhononicBandStructure"@en .

