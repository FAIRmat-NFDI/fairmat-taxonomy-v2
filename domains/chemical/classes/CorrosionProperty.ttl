@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:CorrosionProperty a owl:Class ;
    rdfs:comment "Property that describes the deterioration of a material when it interacts with the environment via chemical reactions."@en ;
    rdfs:subClassOf tax:ChemicalProperty ;
    skos:prefLabel "CorrosionProperty"@en .

