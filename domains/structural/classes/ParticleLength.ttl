@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/ParticleLength> a owl:Class ;
    rdfs:comment "Average length of the particles."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/StructuralProperty> ;
    skos:altLabel "Length"@en ;
    skos:prefLabel "ParticleLength"@en .

