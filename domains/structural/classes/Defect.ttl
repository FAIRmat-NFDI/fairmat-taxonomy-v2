@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:Defect a owl:Class ;
    rdfs:comment "Defect of different dimensions (from 0D point defects to 2D interfaces) in a given material."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:prefLabel "Defect"@en .

