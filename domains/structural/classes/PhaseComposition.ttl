@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:PhaseComposition a owl:Class ;
    rdfs:comment "Relative amounts of each phase in the material."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:altLabel "Fraction"@en ;
    skos:prefLabel "PhaseComposition"@en .

