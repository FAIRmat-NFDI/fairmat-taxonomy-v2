@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/2.1/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:Volume a owl:Class ;
    rdfs:comment "Volume of the material."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue qk:Volume ;
            owl:onProperty qudt:hasQuantityKind ],
        tax:StructuralProperty ;
    skos:altLabel "EffectiveVolume"@en ;
    skos:prefLabel "Volume"@en .

