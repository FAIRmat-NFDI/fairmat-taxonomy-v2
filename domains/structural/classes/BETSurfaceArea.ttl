@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:BETSurfaceArea a owl:Class ;
    rdfs:comment "Brunauer-Emmett-Teller (BET) surface area of the material."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:altLabel "BetSurfaceArea"@en ;
    skos:prefLabel "BETSurfaceArea"@en .

