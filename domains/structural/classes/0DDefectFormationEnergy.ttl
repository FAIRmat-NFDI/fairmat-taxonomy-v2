@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:0DDefectFormationEnergy a owl:Class ;
    rdfs:comment "Defect formation energy, also defined as the lattice cohesive energy in the case of 0D defect."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:altLabel "FormationEnergy"@en ;
    skos:prefLabel "0DDefectFormationEnergy"@en .

