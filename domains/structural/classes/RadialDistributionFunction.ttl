@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:RadialDistributionFunction a owl:Class ;
    rdfs:comment "Density variation as a function of distance from a reference particle."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:prefLabel "RadialDistributionFunction"@en .

