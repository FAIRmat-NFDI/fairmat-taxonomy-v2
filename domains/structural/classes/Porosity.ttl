@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:Porosity a owl:Class ;
    rdfs:comment "Ratio of the pore volume with respect to the total volume of the material."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:altLabel "PoreDensity"@en ;
    skos:prefLabel "Porosity"@en .

