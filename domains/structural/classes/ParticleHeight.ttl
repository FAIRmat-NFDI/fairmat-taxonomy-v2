@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ParticleHeight a owl:Class ;
    rdfs:comment "Average height of the particles."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:altLabel "Height"@en ;
    skos:prefLabel "ParticleHeight"@en .

