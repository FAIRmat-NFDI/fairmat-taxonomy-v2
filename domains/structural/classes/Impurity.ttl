@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:Impurity a owl:Class ;
    rdfs:comment "Chemical substances inside a material which differ from the chemical composition of the material or compound."@en ;
    rdfs:subClassOf tax:StructuralProperty ;
    skos:prefLabel "Impurity"@en .

