@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:FatigueCrackGrowthThreshold a owl:Class ;
    rdfs:comment "Asymptotic value of the stress intensity factor range at which crack growth rate approaches zero."@en ;
    rdfs:subClassOf tax:FatigueProperty ;
    skos:prefLabel "FatigueCrackGrowthThreshold"@en .

