@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:FatigueCrackGrowthRate a owl:Class ;
    rdfs:comment "Rate of crack extension under fatigue loading, expressed in terms of crack extension per cycle."@en ;
    rdfs:subClassOf tax:FatigueProperty ;
    skos:prefLabel "FatigueCrackGrowthRate"@en .

