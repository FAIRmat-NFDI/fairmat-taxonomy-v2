@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/FatigueLimit> a owl:Class ;
    rdfs:comment "Highest stress that materials can withstand for an infinite number of cycles without fatigue failure."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/FatigueProperty> ;
    skos:prefLabel "FatigueLimit"@en .

