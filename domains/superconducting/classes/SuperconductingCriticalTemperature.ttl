@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:SuperconductingCriticalTemperature a owl:Class ;
    rdfs:comment "Critical temperature at which a material conducts electricity without resistance."@en ;
    rdfs:subClassOf tax:SuperconductingProperty ;
    skos:prefLabel "SuperconductingCriticalTemperature"@en .

