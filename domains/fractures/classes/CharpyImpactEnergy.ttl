@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:CharpyImpactEnergy a owl:Class ;
    rdfs:comment "Amount of energy needed to fracture a material during a Charpy impact test."@en ;
    rdfs:subClassOf tax:FracturesProperty ;
    skos:prefLabel "CharpyImpactEnergy"@en .

