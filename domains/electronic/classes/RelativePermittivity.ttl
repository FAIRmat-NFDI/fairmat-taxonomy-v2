@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:RelativePermittivity a owl:Class ;
    rdfs:comment "Ratio of the permittivity with respect to the vacuum permittivity."@en ;
    rdfs:subClassOf tax:ElectronicProperty ;
    skos:altLabel "DielectricConstant"@en ;
    skos:prefLabel "RelativePermittivity"@en .

