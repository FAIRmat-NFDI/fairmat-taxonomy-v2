@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ElectronicSusceptibility a owl:Class ;
    rdfs:comment "Degree of polarization of a material in the presence of an electric field."@en ;
    rdfs:subClassOf tax:ElectronicProperty ;
    skos:prefLabel "ElectronicSusceptibility"@en .

