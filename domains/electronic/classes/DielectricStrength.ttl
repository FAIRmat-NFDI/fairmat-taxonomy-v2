@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:DielectricStrength a owl:Class ;
    rdfs:comment "Maximum electric field that the material can withstand under ideal conditions without undergoing electrical breakdown and becoming conductive."@en ;
    rdfs:subClassOf tax:ElectronicProperty ;
    skos:prefLabel "DielectricStrength"@en .

