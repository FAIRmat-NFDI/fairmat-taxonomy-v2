@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ElectronicBandGap a owl:Class ;
    rdfs:comment "Energy difference between the highest occupied electronic state and the lowest unoccupied electronic state."@en ;
    rdfs:subClassOf tax:ElectronicProperty ;
    skos:prefLabel "ElectronicBandGap"@en .

