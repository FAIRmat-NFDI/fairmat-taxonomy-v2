@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ElectronicProperty a owl:Class ;
    rdfs:comment "Property that describes the behaviour of charges (electrons or holes) in a given material."@en ;
    rdfs:subClassOf tax:MaterialProperty ;
    skos:prefLabel "ElectronicProperty"@en .

