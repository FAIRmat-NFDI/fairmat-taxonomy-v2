@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/SaturationMagentization> a owl:Class ;
    rdfs:comment "Maximum magnetization that a material can achieve when all the magnetic moments are aligned and increasing the applied magnetic field does not further change the magnetization."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/MagneticProperty> ;
    skos:prefLabel "SaturationMagentization"@en .

