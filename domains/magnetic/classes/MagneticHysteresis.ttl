@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:MagneticHysteresis a owl:Class ;
    rdfs:comment "Magnetization history of a material in terms of the applied magnetic field."@en ;
    rdfs:subClassOf tax:MagneticProperty ;
    skos:prefLabel "MagneticHysteresis"@en .

