@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep: <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

rep:ComponentProperty a owl:Class ;
    rdfs:subClassOf rep:Representation ;
    owl:disjointUnionOf ( rep:Axis rep:Signal rep:UnitAttribute ) ;
    skos:prefLabel "ComponentProperty"@en .

