@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:IonicMobility a owl:Class ;
    rdfs:comment "Speed of the ion motion when subjected to an electric field."@en ;
    rdfs:subClassOf tax:ElectronicTransportProperty ;
    skos:prefLabel "IonicMobility"@en .

