@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:HallCoefficient a owl:Class ;
    rdfs:comment "Ratio of the induced electric field to the product of the applied current and magnetic field. It can be also defined as the inverse of the carrier density and electric charge."@en ;
    rdfs:subClassOf tax:ElectronicTransportProperty ;
    skos:prefLabel "HallCoefficient"@en .

