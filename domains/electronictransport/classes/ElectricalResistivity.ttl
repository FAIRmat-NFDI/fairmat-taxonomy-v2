@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ElectricalResistivity a owl:Class ;
    rdfs:comment "Resistance of the charges to move in the presence of an electric current."@en ;
    rdfs:subClassOf tax:ElectronicTransportProperty ;
    skos:prefLabel "ElectricalResistivity"@en .

