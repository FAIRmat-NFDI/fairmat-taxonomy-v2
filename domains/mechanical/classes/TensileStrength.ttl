@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/TensileStrength> a owl:Class ;
    rdfs:comment "Maximum stress that can be applied to the material before breaking."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/MechanicalProperty> ;
    skos:altLabel "UltimateTensileStrength"@en ;
    skos:prefLabel "TensileStrength"@en .

