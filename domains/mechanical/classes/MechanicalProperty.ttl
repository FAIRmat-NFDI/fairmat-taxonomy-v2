@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:MechanicalProperty a owl:Class ;
    rdfs:comment "Property that describes the response of a material to the application of forces."@en ;
    rdfs:subClassOf tax:MaterialProperty ;
    skos:prefLabel "MechanicalProperty"@en .

