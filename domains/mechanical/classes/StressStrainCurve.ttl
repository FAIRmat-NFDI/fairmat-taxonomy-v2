@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:StressStrainCurve a owl:Class ;
    rdfs:comment "Relationship between stress and strain for a material. This curve gives the values of the Young's modulus, the yield strength, etc."@en ;
    rdfs:subClassOf tax:MechanicalProperty ;
    skos:prefLabel "StressStrainCurve"@en .

