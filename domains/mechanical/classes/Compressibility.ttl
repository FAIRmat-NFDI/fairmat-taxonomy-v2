@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:Compressibility a owl:Class ;
    rdfs:comment "Response of the material to changes in the volume due to external pressure."@en ;
    rdfs:subClassOf tax:MechanicalProperty ;
    skos:prefLabel "Compressibility"@en .

