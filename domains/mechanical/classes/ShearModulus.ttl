@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:ShearModulus a owl:Class ;
    rdfs:comment "Response of a material to shear stress and defined as the ratio of shear stress to the shear strain."@en ;
    rdfs:subClassOf tax:MechanicalProperty ;
    skos:prefLabel "ShearModulus"@en .

