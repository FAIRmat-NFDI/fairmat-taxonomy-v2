@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:YieldStrength a owl:Class ;
    rdfs:comment "The stress value at which the plastic deformation of a material begins to occur."@en ;
    rdfs:subClassOf tax:MechanicalProperty ;
    skos:prefLabel "YieldStrength"@en .

