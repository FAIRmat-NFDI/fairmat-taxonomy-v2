@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

tax:CriticalResolvedShearStress a owl:Class ;
    rdfs:comment "Component of shear stress, resolved in the direction of slip, necessary to initiate slip in a grain."@en ;
    rdfs:subClassOf tax:MechanicalProperty ;
    skos:altLabel "CRSS"@en ;
    skos:prefLabel "CriticalResolvedShearStress"@en .

