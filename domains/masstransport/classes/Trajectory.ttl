@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://fairmat-nfdi.eu/taxonomy/Trajectory> a owl:Class ;
    rdfs:comment "Evolution of a system of particles or molecules with time."@en ;
    rdfs:subClassOf <http://fairmat-nfdi.eu/taxonomy/MassTransportProperty> ;
    skos:prefLabel "Trajectory"@en .

