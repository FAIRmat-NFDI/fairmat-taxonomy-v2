@prefix ex:   <http://example.org/data#> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qudt: <http://qudt.org/2.1/schema/qudt/> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
##  scalar-invalid-metre-abox.ttl
##  expect: REP-UNIT-001, REP-UNIT-010
##
## Scalar temperature in metres. Dimensional nonsense.
## Fires at both layers: not admissible for qk:Temperature at all
## (Layer 1), and outside the Scalar temperature profile (Layer 2).
##
##  Standalone data graph. Validate with:
##      python test/representation_test.py
##  Several example files contradict each other on purpose and are
##  never loaded together.
#################################################################

ex:tc_broken a rep:Scalar , qb:DataSet ;
    rep:rank "0"^^xsd:nonNegativeInteger ;
    qb:structure ex:dsd_05 .

ex:dsd_05 a rep:DataStructureDefinition , qb:DataStructureDefinition ;
    qb:component ex:cs_05_temperature .

ex:cs_05_temperature a qb:ComponentSpecification ;
    qb:measure rep:temperature ;
    rep:hasUnit unit:M .            #### WRONG: a length unit on a temperature signal

### lifted observation -- the number is present even though its declared unit is invalid
ex:obs_05_000 a rep:Observation , qb:Observation ;
    qb:dataSet ex:tc_broken ;
    rep:temperature "1811.0"^^xsd:double .
