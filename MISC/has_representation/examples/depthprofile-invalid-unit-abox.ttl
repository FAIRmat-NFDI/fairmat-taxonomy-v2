@prefix ex:   <http://example.org/representation/> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## expect: REP-UNIT-001, REP-UNIT-013
## case: DepthProfile / invalid supplied unit

ex:depthprofile-bad-dataset a rep:DepthProfile ;
    rep:rank "1"^^xsd:nonNegativeInteger ;
    rep:extent "1"^^xsd:nonNegativeInteger ;
    qb:structure ex:depthprofile-bad-dsd .

ex:depthprofile-bad-dsd a rep:DataStructureDefinition ;
    qb:component
        ex:depthprofile-bad-axis-depth,
        ex:depthprofile-bad-signal .

ex:depthprofile-bad-axis-depth a qb:ComponentSpecification ;
    qb:dimension rep:depth ; rep:hasUnit unit:SEC .

ex:depthprofile-bad-signal a qb:ComponentSpecification ;
    qb:measure rep:intensity .

ex:depthprofile-bad-observation a rep:Observation ;
    qb:dataSet ex:depthprofile-bad-dataset ;
    rep:depth "25.0"^^xsd:double ;
    rep:intensity "125"^^xsd:nonNegativeInteger .

