@prefix ex:   <http://example.org/representation/> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## expect: REP-UNIT-004, REP-UNIT-005
## case: Image / invalid missing quantity kind

ex:image-missing-dataset a rep:Image ;
    rep:rank "2"^^xsd:nonNegativeInteger ;
    rep:extent "1"^^xsd:nonNegativeInteger ;
    qb:structure ex:image-missing-dsd .

ex:image-missing-dsd a rep:DataStructureDefinition ;
    qb:component
        ex:image-missing-axis-y,
        ex:image-missing-axis-x,
        ex:image-missing-signal .

ex:image-missing-axis-y a qb:ComponentSpecification ;
    qb:dimension rep:y .

ex:image-missing-axis-x a qb:ComponentSpecification ;
    qb:dimension rep:x .

ex:image-missing-signal a qb:ComponentSpecification ;
    qb:measure ex:image-untyped-signal ; rep:hasUnit unit:COUNT .

ex:image-untyped-signal a rep:Signal .

ex:image-missing-observation a rep:Observation ;
    qb:dataSet ex:image-missing-dataset ;
    rep:y "0"^^xsd:nonNegativeInteger ;
    rep:x "0"^^xsd:nonNegativeInteger ;
    ex:image-untyped-signal "125"^^xsd:nonNegativeInteger .

