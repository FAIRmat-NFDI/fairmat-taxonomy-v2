@prefix ex:   <http://example.org/representation/> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## expect: REP-UNIT-001, REP-UNIT-015
## case: VolumeData / invalid supplied unit

ex:volume-bad-dataset a rep:VolumeData ;
    rep:rank "3"^^xsd:nonNegativeInteger ;
    rep:extent "1"^^xsd:nonNegativeInteger ;
    qb:structure ex:volume-bad-dsd .

ex:volume-bad-dsd a rep:DataStructureDefinition ;
    qb:component
        ex:volume-bad-axis-z,
        ex:volume-bad-axis-y,
        ex:volume-bad-axis-x,
        ex:volume-bad-signal .

ex:volume-bad-axis-z a qb:ComponentSpecification ;
    qb:dimension rep:z ; rep:hasUnit unit:SEC .

ex:volume-bad-axis-y a qb:ComponentSpecification ;
    qb:dimension rep:y .

ex:volume-bad-axis-x a qb:ComponentSpecification ;
    qb:dimension rep:x .

ex:volume-bad-signal a qb:ComponentSpecification ;
    qb:measure rep:intensity .

ex:volume-bad-observation a rep:Observation ;
    qb:dataSet ex:volume-bad-dataset ;
    rep:z "0"^^xsd:nonNegativeInteger ;
    rep:y "0"^^xsd:nonNegativeInteger ;
    rep:x "0"^^xsd:nonNegativeInteger ;
    rep:intensity "125"^^xsd:nonNegativeInteger .

