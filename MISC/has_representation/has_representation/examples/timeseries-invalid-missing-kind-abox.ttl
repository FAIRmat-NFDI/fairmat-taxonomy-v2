@prefix ex:   <http://example.org/representation/> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## expect: REP-UNIT-004, REP-UNIT-005
## case: TimeSeries / invalid missing quantity kind

ex:timeseries-missing-dataset a rep:TimeSeries ;
    rep:rank "1"^^xsd:nonNegativeInteger ;
    rep:extent "1"^^xsd:nonNegativeInteger ;
    qb:structure ex:timeseries-missing-dsd .

ex:timeseries-missing-dsd a rep:DataStructureDefinition ;
    qb:component
        ex:timeseries-missing-axis-time,
        ex:timeseries-missing-signal .

ex:timeseries-missing-axis-time a qb:ComponentSpecification ;
    qb:dimension rep:time .

ex:timeseries-missing-signal a qb:ComponentSpecification ;
    qb:measure ex:timeseries-untyped-signal ; rep:hasUnit unit:COUNT .

ex:timeseries-untyped-signal a rep:Signal .

ex:timeseries-missing-observation a rep:Observation ;
    qb:dataSet ex:timeseries-missing-dataset ;
    rep:time "0.5"^^xsd:double ;
    ex:timeseries-untyped-signal "125"^^xsd:nonNegativeInteger .

