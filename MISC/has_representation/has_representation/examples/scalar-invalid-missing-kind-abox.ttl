@prefix ex:   <http://example.org/representation/> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## expect: REP-UNIT-004, REP-UNIT-005
## case: Scalar / invalid missing quantity kind

ex:scalar-missing-dataset a rep:Scalar ;
    rep:rank "0"^^xsd:nonNegativeInteger ;
    rep:extent "1"^^xsd:nonNegativeInteger ;
    qb:structure ex:scalar-missing-dsd .

ex:scalar-missing-dsd a rep:DataStructureDefinition ;
    qb:component
        ex:scalar-missing-signal .

ex:scalar-missing-signal a qb:ComponentSpecification ;
    qb:measure ex:scalar-untyped-signal ; rep:hasUnit unit:K .

ex:scalar-untyped-signal a rep:Signal .

ex:scalar-missing-observation a rep:Observation ;
    qb:dataSet ex:scalar-missing-dataset ;
    ex:scalar-untyped-signal "293.15"^^xsd:double .

