@prefix ex:   <http://example.org/representation/> .
@prefix rep:  <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix tax:  <http://fairmat-nfdi.eu/taxonomy/> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## expect: REP-UNIT-004, REP-UNIT-005
## case: Spectrum / invalid missing quantity kind

ex:spectrum-missing-dataset a rep:Spectrum ;
    rep:rank "1"^^xsd:nonNegativeInteger ;
    rep:extent "1"^^xsd:nonNegativeInteger ;
    qb:structure ex:spectrum-missing-dsd .

ex:spectrum-missing-dsd a rep:DataStructureDefinition ;
    qb:component
        ex:spectrum-missing-axis-energy,
        ex:spectrum-missing-signal .

ex:spectrum-missing-axis-energy a qb:ComponentSpecification ;
    qb:dimension rep:energy .

ex:spectrum-missing-signal a qb:ComponentSpecification ;
    qb:measure ex:spectrum-untyped-signal ; rep:hasUnit unit:COUNT .

ex:spectrum-untyped-signal a rep:Signal .

ex:spectrum-missing-observation a rep:Observation ;
    qb:dataSet ex:spectrum-missing-dataset ;
    rep:energy "10.0"^^xsd:double ;
    ex:spectrum-untyped-signal "125"^^xsd:nonNegativeInteger .

