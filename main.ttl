<http://fairmat-nfdi.eu/taxonomy/PassivationCurrent> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty rep:HasRepresentation ;
    owl:someValuesFrom [ a owl:Class ; owl:intersectionOf (
        rep:Scalar
        [ a owl:Restriction ; owl:onProperty rep:HasSignal ; owl:someValuesFrom
