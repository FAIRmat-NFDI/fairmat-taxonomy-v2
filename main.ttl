<http://fairmat-nfdi.eu/taxonomy/PhononicBandStructure> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty rep:HasRepresentation ;
    owl:someValuesFrom [ a owl:Class ; owl:intersectionOf (
