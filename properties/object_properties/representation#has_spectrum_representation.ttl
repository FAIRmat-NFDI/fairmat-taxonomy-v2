@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep: <http://fairmat-nfdi.eu/taxonomy/representation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tax: <http://fairmat-nfdi.eu/taxonomy/> .

rep:has_spectrum_representation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain tax:MaterialProperty ;
    rdfs:range rep:Spectrum ;
    rdfs:subPropertyOf rep:has_representation ;
    skos:prefLabel "has_spectrum_representation"@en .

